{
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mark-gomez.vercel.app" }],
      "destination": "https://markgomez.vercel.app/:path*",
      "permanent": false
    }
  ]
}
